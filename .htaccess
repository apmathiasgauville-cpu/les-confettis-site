# Réglages de l'hébergement OVH de https://les-confettis.fr
# Fichier fabriqué automatiquement avec le reste du site : ne pas le modifier ici.

Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Une seule adresse : https://les-confettis.fr (le http et le www y sont renvoyés)
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://les-confettis.fr%{REQUEST_URI} [R=301,L]
  # Fichiers et dossiers cachés (.git, .htaccess…) jamais servis, sauf .well-known (certificat)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Pages : toujours revérifiées, pour qu'une retouche se voie tout de suite
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Images : un jour seulement, car une photo remplacée garde le même nom
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  # Polices et bibliothèques : elles ne changent pas
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>
